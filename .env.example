# Neon (Vercel Marketplace) — pooled URL for the app, direct URL for migrations
DATABASE_URL=
DIRECT_URL=


# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public URL of the app (used in password-reset links)
APP_URL="http://localhost:3000"

# Optional: Vercel Blob for keeping uploaded files and weekly backups
BLOB_READ_WRITE_TOKEN=""

# Optional: password-reset email via Resend (sender domain must be verified)
RESEND_API_KEY=""
EMAIL_FROM=""

# Protects /api/cron/* (Vercel sets this header automatically for cron jobs)
CRON_SECRET=""
