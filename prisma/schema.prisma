generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  passwordHash          String    @map("password_hash")
  role                  String    @default("viewer")
  themePref             String    @default("system") @map("theme_pref")
  failedAttempts        Int       @default(0) @map("failed_attempts")
  lockedUntil           DateTime? @map("locked_until")
  lastLogin             DateTime? @map("last_login")
  passwordChangedAt     DateTime  @default(now()) @map("password_changed_at")
  /// Set when an admin creates the account or generates a new password: the user must choose their own on next sign-in.
  mustChangePassword    Boolean   @default(false) @map("must_change_password")
  /// A generated (temporary) password stops working after this time.
  tempPasswordExpiresAt DateTime? @map("temp_password_expires_at")
  createdById           String?   @map("created_by_id")
  createdAt             DateTime  @default(now()) @map("created_at")

  resetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Member {
  id                 Int       @id @default(autoincrement())
  firstName          String    @map("first_name")
  lastName           String    @default("") @map("last_name")
  nameKey            String    @map("name_key")
  phone              String?
  phoneKey           String?   @map("phone_key")
  altPhone           String?   @map("alt_phone")
  email              String?
  address            String?
  gender             String?
  status             String
  branch             String    @default("Main")
  personResponsible  String?   @map("person_responsible")
  firstSeenServiceId Int?      @map("first_seen_service_id")
  flags              String[]  @default([])
  notes              String?
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  firstSeenService Service?           @relation("FirstSeen", fields: [firstSeenServiceId], references: [id], onDelete: SetNull)
  teams            MemberTeam[]
  attendance       Attendance[]
  statusHistory    StatusHistory[]
  followUps        FollowUp[]
  suggestions      StatusSuggestion[]

  @@unique([nameKey, phoneKey])
  @@index([phoneKey])
  @@index([status])
  @@map("members")
}

model Team {
  id      Int          @id @default(autoincrement())
  name    String       @unique
  members MemberTeam[]

  @@map("teams")
}

model MemberTeam {
  memberId Int    @map("member_id")
  teamId   Int    @map("team_id")
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([memberId, teamId])
  @@map("member_teams")
}

model Service {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique @db.Date
  type        String   @default("sunday")
  recordTaken Boolean  @default(true) @map("record_taken")

  attendance Attendance[]
  headcounts ServiceHeadcount[]
  notes      ServiceNote[]
  firstSeen  Member[]           @relation("FirstSeen")

  @@map("services")
}

model Attendance {
  memberId  Int      @map("member_id")
  serviceId Int      @map("service_id")
  markedAt  DateTime @default(now()) @map("marked_at")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([memberId, serviceId])
  @@index([serviceId])
  @@map("attendance")
}

model ServiceHeadcount {
  id           Int      @id @default(autoincrement())
  serviceId    Int      @map("service_id")
  workers      Int
  members      Int
  firstTimers  Int      @map("first_timers")
  secondTimers Int      @map("second_timers")
  male         Int
  female       Int
  children     Int
  /// Guests, pastors and visitors not in the register (entered by hand).
  guests       Int      @default(0)
  total        Int
  uploadId     Int?     @map("upload_id")
  version      Int      @default(1)
  isCurrent    Boolean  @default(true) @map("is_current")
  /// Kept in step with the attendance register (filled from an upload or from marking attendance).
  fromRegister Boolean  @default(false) @map("from_register")
  createdAt    DateTime @default(now()) @map("created_at")
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  upload       Upload?  @relation(fields: [uploadId], references: [id], onDelete: SetNull)

  @@index([serviceId, isCurrent])
  @@map("service_headcounts")
}

enum NoteType {
  streak
  returnee
  convert
  general
}

model ServiceNote {
  id        Int      @id @default(autoincrement())
  serviceId Int      @map("service_id")
  type      NoteType @default(general)
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_notes")
}

model Upload {
  id         Int      @id @default(autoincrement())
  kind       String
  fileName   String   @map("file_name")
  blobUrl    String?  @map("blob_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  rowsOk     Int      @default(0) @map("rows_ok")
  rowsFailed Int      @default(0) @map("rows_failed")
  status     String   @default("completed")
  summary    Json?

  headcounts ServiceHeadcount[]

  @@map("uploads")
}

model StatusHistory {
  id        Int      @id @default(autoincrement())
  memberId  Int      @map("member_id")
  old       String?
  new       String
  changedAt DateTime @default(now()) @map("changed_at")
  reason    String?
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("status_history")
}

model FollowUp {
  id       Int      @id @default(autoincrement())
  memberId Int      @map("member_id")
  date     DateTime @default(now())
  method   String
  outcome  String
  note     String?
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("follow_ups")
}

model StatusSuggestion {
  id         Int       @id @default(autoincrement())
  memberId   Int       @map("member_id")
  fromStatus String    @map("from_status")
  toStatus   String    @map("to_status")
  reason     String
  state      String    @default("pending")
  createdAt  DateTime  @default(now()) @map("created_at")
  decidedAt  DateTime? @map("decided_at")
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([state])
  @@map("status_suggestions")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  at         DateTime @default(now())
  ip         String?
  /// Who did it. Email is copied so the entry survives the user being deleted.
  actorId    String?  @map("actor_id")
  actorEmail String?  @map("actor_email")

  @@index([at])
  @@index([actorId])
  @@index([entity, entityId])
  @@map("audit_log")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}
